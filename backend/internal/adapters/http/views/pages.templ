package views

templ Document(title string) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="theme-color" content="#070b14"/>
			<title>{ title }</title>
			<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
			<link rel="shortcut icon" href="/favicon.svg" type="image/svg+xml"/>
			<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
			<script src="https://unpkg.com/htmx.org@1.9.12"></script>
			<script>
				(function() {
					const key = "emaildash-theme";
					const root = document.documentElement;
					let saved = "";
					try {
						saved = localStorage.getItem(key) || "";
					} catch (error) {}
					const initial = saved === "light" || saved === "dark" ? saved : "dark";
					function apply(theme) {
						root.dataset.theme = theme;
						root.style.colorScheme = theme;
						document.querySelectorAll("[data-theme-label]").forEach(function(label) {
							label.textContent = theme === "dark" ? "Dark" : "Light";
						});
						document.querySelectorAll("[data-theme-toggle]").forEach(function(button) {
							button.setAttribute("aria-pressed", theme === "dark" ? "true" : "false");
						});
					}
					apply(initial);
					window.emaildashToggleTheme = function() {
						const next = root.dataset.theme === "dark" ? "light" : "dark";
						try {
							localStorage.setItem(key, next);
						} catch (error) {}
						apply(next);
					};
					document.addEventListener("DOMContentLoaded", function() {
						apply(root.dataset.theme || initial);
					});
				})();
			</script>
			<style>
				:root {
					color-scheme: dark;
					--bg: #070b14;
					--surface: #0f1726;
					--surface-soft: #121c2d;
					--surface-raised: #172236;
					--ink: #e8eef8;
					--muted: #98a8bd;
					--label: #c9d5e6;
					--line: #26354c;
					--line-soft: #1b293e;
					--brand: #69a7ff;
					--brand-strong: #3b82f6;
					--brand-soft: #10284d;
					--brand-soft-strong: #173a70;
					--accent: #2dd4bf;
					--warning: #f6c453;
					--danger: #ff8a80;
					--success-bg: #063a30;
					--success-ink: #5eead4;
					--warning-bg: #3a2a08;
					--neutral-bg: #1c2738;
					--topbar-bg: rgba(10, 15, 26, 0.9);
					--brand-mark-bg: #e8eef8;
					--brand-mark-ink: #0b1020;
					--auth-brand-bg: #0b1220;
					--auth-brand-ink: #f8fafc;
					--auth-brand-muted: #a7b7cd;
					--nav-hover: #172236;
					--active-bg: #132a4d;
					--item-hover: #121e31;
					--code-bg: #050916;
					--code-ink: #dbeafe;
					--message-bg: #ffffff;
					--message-ink: #101828;
					--toggle-track: #2563eb;
					--shadow: 0 18px 44px rgba(0, 0, 0, 0.34);
				}
				:root[data-theme="light"] {
					color-scheme: light;
					--bg: #f4f6f9;
					--surface: #ffffff;
					--surface-soft: #f8fafc;
					--surface-raised: #ffffff;
					--ink: #101828;
					--muted: #667085;
					--label: #344054;
					--line: #d8dee8;
					--line-soft: #eaedf3;
					--brand: #2563eb;
					--brand-strong: #1746a2;
					--brand-soft: #eef4ff;
					--brand-soft-strong: #dbeafe;
					--accent: #0f766e;
					--warning: #b7791f;
					--danger: #b42318;
					--success-bg: #ecfdf3;
					--success-ink: #027a48;
					--warning-bg: #fffaeb;
					--neutral-bg: #f2f4f7;
					--topbar-bg: rgba(255, 255, 255, 0.92);
					--brand-mark-bg: #111827;
					--brand-mark-ink: #ffffff;
					--auth-brand-bg: #111827;
					--auth-brand-ink: #ffffff;
					--auth-brand-muted: #cbd5e1;
					--nav-hover: #eef2f7;
					--active-bg: #ffffff;
					--item-hover: #f8fbff;
					--code-bg: #0f172a;
					--code-ink: #e2e8f0;
					--message-bg: #ffffff;
					--message-ink: #101828;
					--toggle-track: #d8dee8;
					--shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
				}
				* { box-sizing: border-box; }
				body {
					margin: 0;
					background: var(--bg);
					color: var(--ink);
					font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
					font-size: 14px;
					letter-spacing: 0;
				}
				a { color: inherit; }
				code, .docs-code, .api-key-box {
					font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
				}
				code { color: var(--brand); overflow-wrap: anywhere; word-break: break-word; }
				.app-shell { min-height: 100vh; }
				.topbar {
					position: sticky;
					top: 0;
					z-index: 20;
					display: flex;
					align-items: center;
					justify-content: space-between;
					gap: 20px;
					min-height: 68px;
					padding: 12px 28px;
					background: var(--topbar-bg);
					border-bottom: 1px solid var(--line);
					backdrop-filter: blur(18px);
				}
				.brand {
					display: inline-flex;
					align-items: center;
					gap: 10px;
					text-decoration: none;
					font-weight: 750;
					color: var(--ink);
				}
				.brand-mark {
					display: grid;
					place-items: center;
					width: 34px;
					height: 34px;
					border-radius: 8px;
					background: var(--brand-mark-bg);
					color: var(--brand-mark-ink);
					font-size: 12px;
					letter-spacing: 0;
				}
				.top-nav {
					display: flex;
					align-items: center;
					gap: 6px;
					padding: 4px;
					border: 1px solid var(--line);
					border-radius: 8px;
					background: var(--surface-soft);
				}
				.top-nav-link {
					display: inline-flex;
					align-items: center;
					min-height: 34px;
					padding: 7px 12px;
					border-radius: 6px;
					color: var(--muted);
					font-weight: 650;
					text-decoration: none;
					white-space: nowrap;
				}
				.top-nav-link:hover { color: var(--ink); background: var(--nav-hover); }
				.top-nav-link.is-active {
					background: var(--active-bg);
					color: var(--brand);
					box-shadow: 0 1px 3px rgba(16, 24, 40, 0.12);
				}
				.top-actions { display: flex; align-items: center; gap: 10px; }
				.theme-toggle {
					display: inline-flex;
					align-items: center;
					justify-content: center;
					gap: 8px;
					min-height: 38px;
					padding: 6px 10px;
					border: 1px solid var(--line);
					border-radius: 8px;
					background: var(--surface);
					color: var(--ink);
					font-weight: 750;
					white-space: nowrap;
				}
				.theme-toggle:hover { background: var(--surface-soft); }
				.theme-toggle-track {
					position: relative;
					display: inline-flex;
					width: 40px;
					height: 22px;
					border-radius: 999px;
					background: var(--toggle-track);
					box-shadow: inset 0 0 0 1px rgba(255,255,255,.12);
				}
				.theme-toggle-knob {
					position: absolute;
					top: 3px;
					left: 3px;
					width: 16px;
					height: 16px;
					border-radius: 999px;
					background: #fff;
					box-shadow: 0 2px 6px rgba(0,0,0,.22);
					transform: translateX(18px);
					transition: transform .18s ease;
				}
				:root[data-theme="light"] .theme-toggle-knob { transform: translateX(0); }
				.app-main {
					width: min(1680px, 100%);
					margin: 0 auto;
					padding: 24px 28px 32px;
				}
				.page-heading {
					display: flex;
					align-items: end;
					justify-content: space-between;
					gap: 18px;
					margin-bottom: 18px;
				}
				.eyebrow {
					margin: 0 0 4px;
					color: var(--muted);
					font-size: 12px;
					font-weight: 750;
					letter-spacing: .08em;
					text-transform: uppercase;
				}
				.page-title {
					margin: 0;
					font-size: clamp(26px, 3vw, 38px);
					line-height: 1;
					font-weight: 780;
				}
				.metric-strip { display: flex; flex-wrap: wrap; gap: 8px; justify-content: end; }
				.metric {
					display: inline-flex;
					align-items: center;
					gap: 8px;
					min-height: 34px;
					padding: 6px 10px;
					border: 1px solid var(--line);
					border-radius: 8px;
					background: var(--surface);
					color: var(--muted);
					font-weight: 650;
				}
				.metric strong { color: var(--ink); }
				.alert {
					border-radius: 8px;
					border-width: 1px;
					box-shadow: none;
				}
				.alert-danger {
					background: color-mix(in srgb, var(--danger) 16%, var(--surface));
					border-color: color-mix(in srgb, var(--danger) 34%, var(--line));
					color: var(--ink);
				}
				.alert-success {
					background: color-mix(in srgb, var(--accent) 14%, var(--surface));
					border-color: color-mix(in srgb, var(--accent) 30%, var(--line));
					color: var(--ink);
				}
				.btn {
					border-radius: 6px;
					font-weight: 700;
					letter-spacing: 0;
				}
				.btn-primary {
					background: var(--brand);
					border-color: var(--brand);
				}
				.btn-primary:hover {
					background: var(--brand-strong);
					border-color: var(--brand-strong);
				}
				.btn-outline-secondary {
					color: var(--ink);
					border-color: var(--line);
					background: var(--surface);
				}
				.btn-outline-secondary:hover {
					color: var(--ink);
					border-color: var(--line);
					background: var(--surface-soft);
				}
				.form-control, .form-select {
					min-height: 42px;
					border-radius: 6px;
					border-color: var(--line);
					background: var(--surface);
					color: var(--ink);
				}
				.form-control:focus, .form-select:focus {
					border-color: var(--brand);
					box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .14);
				}
				.form-control::placeholder { color: var(--muted); }
				.text-secondary { color: var(--muted) !important; }
				.form-label {
					color: var(--label);
					font-size: 13px;
					font-weight: 700;
				}
				.auth-shell {
					display: grid;
					min-height: 100vh;
					place-items: center;
					padding: 28px;
				}
				.auth-panel {
					width: min(960px, 100%);
					display: grid;
					grid-template-columns: .95fr 1.05fr;
					overflow: hidden;
					border: 1px solid var(--line);
					border-radius: 8px;
					background: var(--surface);
					box-shadow: var(--shadow);
				}
				.auth-brand {
					padding: 34px;
					background: var(--auth-brand-bg);
					color: var(--auth-brand-ink);
				}
				.auth-brand h1 {
					margin: 18px 0 12px;
					font-size: 34px;
					font-weight: 800;
				}
				.auth-brand p { color: var(--auth-brand-muted); margin: 0; max-width: 28rem; }
				.auth-form { padding: 34px; align-self: center; }
				.auth-form-head {
					display: flex;
					align-items: center;
					justify-content: space-between;
					gap: 16px;
					margin-bottom: 20px;
				}
				.auth-form h2 { margin: 0 0 20px; font-size: 24px; font-weight: 760; }
				.auth-form-head h2 { margin: 0; }
				.inbox-layout {
					display: grid;
					grid-template-columns: minmax(230px, .78fr) minmax(310px, 1fr) minmax(420px, 1.42fr);
					min-height: calc(100vh - 174px);
					border: 1px solid var(--line);
					border-radius: 8px;
					overflow: hidden;
					background: var(--line);
					box-shadow: var(--shadow);
				}
				.pane {
					min-width: 0;
					background: var(--surface);
				}
				.pane + .pane { border-left: 1px solid var(--line); }
				.pane-header {
					display: flex;
					align-items: center;
					justify-content: space-between;
					gap: 12px;
					min-height: 58px;
					padding: 15px 16px;
					border-bottom: 1px solid var(--line);
					background: var(--surface-soft);
				}
				.pane-title {
					margin: 0;
					font-size: 13px;
					font-weight: 800;
					letter-spacing: .08em;
					text-transform: uppercase;
					color: var(--muted);
				}
				.count-pill, .status-pill {
					display: inline-flex;
					align-items: center;
					justify-content: center;
					min-width: 28px;
					min-height: 24px;
					padding: 3px 8px;
					border-radius: 999px;
					background: var(--brand-soft);
					color: var(--brand);
					font-size: 12px;
					font-weight: 800;
				}
				.status-pill.ok { background: var(--success-bg); color: var(--success-ink); }
				.status-pill.warn { background: var(--warning-bg); color: var(--warning); }
				.status-pill.neutral { background: var(--neutral-bg); color: var(--muted); }
				.stack-list { display: grid; }
				.stack-item {
					display: block;
					padding: 12px 14px;
					border-bottom: 1px solid var(--line-soft);
					color: var(--ink);
					text-decoration: none;
				}
				.stack-item:hover { background: var(--item-hover); }
				.stack-item.is-active {
					background: var(--active-bg);
					box-shadow: inset 3px 0 0 var(--brand);
				}
				.item-main {
					display: flex;
					align-items: start;
					justify-content: space-between;
					gap: 12px;
				}
				.item-title {
					min-width: 0;
					font-weight: 760;
					overflow-wrap: anywhere;
				}
				.item-meta {
					margin-top: 4px;
					color: var(--muted);
					font-size: 12px;
					line-height: 1.35;
					overflow-wrap: anywhere;
				}
				.unread-dot {
					width: 8px;
					height: 8px;
					margin-top: 6px;
					border-radius: 999px;
					background: var(--brand);
					flex: 0 0 auto;
				}
				.empty-state {
					padding: 24px 16px;
					color: var(--muted);
					text-align: center;
				}
				.viewer {
					min-height: 100%;
					display: flex;
					flex-direction: column;
				}
				.viewer-head {
					padding: 20px 22px 16px;
					border-bottom: 1px solid var(--line);
					background: var(--surface);
				}
				.viewer-title {
					margin: 0 0 12px;
					font-size: 22px;
					line-height: 1.2;
					font-weight: 780;
					overflow-wrap: anywhere;
				}
				.meta-grid {
					display: grid;
					gap: 8px;
					color: var(--muted);
					font-size: 13px;
				}
				.meta-grid strong { color: var(--label); font-weight: 760; }
				.viewer-body {
					padding: 18px 22px 22px;
					background: var(--surface-soft);
					flex: 1;
				}
				.message-body {
					max-width: 980px;
					border: 1px solid var(--line);
					border-radius: 8px;
					background: var(--message-bg);
					color: var(--message-ink);
					overflow: auto;
				}
				.message-body.email-html { padding: 18px; }
				.message-body.email-html img { max-width: 100%; height: auto; }
				.pre-wrap {
					margin: 0;
					padding: 18px;
					white-space: pre-wrap;
					word-break: break-word;
					font-size: 13px;
					line-height: 1.55;
				}
				.attachment-list {
					display: grid;
					gap: 8px;
					margin: 14px 0 0;
					padding: 0;
					list-style: none;
				}
				.attachment-item {
					padding: 10px 12px;
					border: 1px solid var(--line);
					border-radius: 8px;
					background: var(--surface);
				}
				.settings-grid {
					display: grid;
					grid-template-columns: repeat(2, minmax(0, 1fr));
					gap: 16px;
				}
				.panel {
					border: 1px solid var(--line);
					border-radius: 8px;
					background: var(--surface);
					box-shadow: var(--shadow);
				}
				.panel-header {
					padding: 16px 18px;
					border-bottom: 1px solid var(--line);
					background: var(--surface-soft);
				}
				.panel-title {
					margin: 0;
					font-size: 16px;
					font-weight: 780;
				}
				.panel-body { padding: 18px; }
				.status-list {
					display: grid;
					gap: 10px;
					margin: 0;
				}
				.status-row {
					display: flex;
					align-items: center;
					justify-content: space-between;
					gap: 14px;
					padding-bottom: 10px;
					border-bottom: 1px solid var(--line-soft);
				}
				.status-row:last-child { border-bottom: 0; padding-bottom: 0; }
				.status-row dt {
					color: var(--muted);
					font-weight: 700;
				}
				.status-row dd {
					margin: 0;
					font-weight: 750;
					text-align: right;
					overflow-wrap: anywhere;
				}
				.table {
					margin: 0;
					--bs-table-bg: transparent;
					--bs-table-color: var(--ink);
					--bs-table-border-color: var(--line);
				}
				.table thead th {
					color: var(--muted);
					font-size: 12px;
					letter-spacing: .06em;
					text-transform: uppercase;
					background: var(--surface-soft);
				}
				.api-key-box, .docs-code {
					white-space: pre-wrap;
					word-break: break-word;
					border: 1px solid var(--line);
					border-radius: 8px;
					background: var(--code-bg);
					color: var(--code-ink);
					padding: 14px;
					margin: 0;
				}
				.docs-shell { width: min(1180px, 100%); margin: 0 auto; padding: 28px; }
				.docs-header {
					display: flex;
					align-items: end;
					justify-content: space-between;
					gap: 16px;
					margin-bottom: 18px;
				}
				.docs-actions {
					display: flex;
					align-items: center;
					gap: 10px;
				}
				.docs-hero {
					display: grid;
					grid-template-columns: minmax(0, 1.1fr) minmax(280px, .9fr);
					gap: 14px;
					margin-bottom: 14px;
				}
				.docs-card {
					border: 1px solid var(--line);
					border-radius: 8px;
					background: var(--surface);
					box-shadow: var(--shadow);
				}
				.docs-card-header {
					padding: 15px 16px;
					border-bottom: 1px solid var(--line);
					background: var(--surface-soft);
				}
				.docs-card-title {
					margin: 0;
					font-size: 15px;
					font-weight: 800;
				}
				.docs-card-body { padding: 16px; }
				.docs-facts {
					display: grid;
					gap: 10px;
					margin: 0;
				}
				.docs-fact {
					display: grid;
					grid-template-columns: 120px minmax(0, 1fr);
					gap: 12px;
					padding-bottom: 10px;
					border-bottom: 1px solid var(--line-soft);
				}
				.docs-fact:last-child { border-bottom: 0; padding-bottom: 0; }
				.docs-fact dt {
					color: var(--muted);
					font-weight: 750;
				}
				.docs-fact dd {
					margin: 0;
					min-width: 0;
					overflow-wrap: anywhere;
				}
				.docs-list {
					display: grid;
					gap: 9px;
					margin: 0;
					padding: 0;
					list-style: none;
				}
				.docs-list li {
					position: relative;
					padding-left: 18px;
					color: var(--label);
				}
				.docs-list li::before {
					content: "";
					position: absolute;
					left: 0;
					top: .62em;
					width: 7px;
					height: 7px;
					border-radius: 999px;
					background: var(--accent);
				}
				.docs-flow {
					display: grid;
					grid-template-columns: repeat(3, minmax(0, 1fr));
					gap: 10px;
				}
				.docs-step {
					padding: 13px;
					border: 1px solid var(--line);
					border-radius: 8px;
					background: var(--surface);
				}
				.docs-step-number {
					display: inline-flex;
					align-items: center;
					justify-content: center;
					width: 26px;
					height: 26px;
					margin-bottom: 9px;
					border-radius: 999px;
					background: var(--brand-soft);
					color: var(--brand);
					font-size: 12px;
					font-weight: 850;
				}
				.docs-step h3 {
					margin: 0 0 5px;
					font-size: 14px;
					font-weight: 800;
				}
				.docs-step p { margin: 0; color: var(--muted); }
				.docs-endpoint {
					border: 1px solid var(--line);
					border-radius: 8px;
					background: var(--surface);
					margin-bottom: 12px;
					overflow: hidden;
				}
				.docs-endpoint-head {
					display: flex;
					align-items: start;
					justify-content: space-between;
					gap: 16px;
					padding: 16px;
					border-bottom: 1px solid var(--line);
					background: var(--surface-soft);
				}
				.docs-endpoint-body {
					display: grid;
					grid-template-columns: repeat(2, minmax(0, 1fr));
					gap: 12px;
					padding: 16px;
				}
				.docs-agent-use {
					grid-column: 1 / -1;
					padding: 12px 14px;
					border: 1px solid var(--line);
					border-radius: 8px;
					background: var(--surface-soft);
					color: var(--label);
				}
				.docs-agent-use strong { color: var(--ink); }
				.docs-schema {
					margin-bottom: 12px;
					overflow: hidden;
				}
				.docs-table-wrap { overflow-x: auto; }
				.docs-table {
					width: 100%;
					min-width: 680px;
					border-collapse: collapse;
				}
				.docs-table th, .docs-table td {
					padding: 10px 12px;
					border-bottom: 1px solid var(--line-soft);
					vertical-align: top;
				}
				.docs-table th {
					color: var(--muted);
					font-size: 12px;
					letter-spacing: .06em;
					text-transform: uppercase;
					background: var(--surface-soft);
				}
				.docs-table tr:last-child td { border-bottom: 0; }
				.method-badge {
					display: inline-flex;
					align-items: center;
					min-height: 24px;
					padding: 2px 8px;
					border-radius: 6px;
					background: var(--brand-soft-strong);
					color: var(--brand-strong);
					font-size: 12px;
					font-weight: 850;
				}
				@media (max-width: 1180px) {
					.inbox-layout { grid-template-columns: 1fr; }
					.pane + .pane { border-left: 0; border-top: 1px solid var(--line); }
					.pane { min-height: auto; }
					.settings-grid { grid-template-columns: 1fr; }
					.docs-hero, .docs-flow { grid-template-columns: 1fr; }
				}
				@media (max-width: 760px) {
					.topbar { position: static; align-items: stretch; flex-direction: column; padding: 14px; }
					.top-nav { width: 100%; overflow-x: auto; }
					.top-actions { width: 100%; display: grid; grid-template-columns: 1fr 1fr; }
					.top-actions .btn, .top-actions form, .top-actions .theme-toggle { width: 100%; }
					.app-main { padding: 18px 14px 24px; }
					.page-heading { align-items: start; flex-direction: column; }
					.metric-strip { justify-content: start; }
					.auth-panel { grid-template-columns: 1fr; }
					.auth-brand, .auth-form { padding: 24px; }
					.docs-shell { padding: 18px 14px; }
					.docs-header, .docs-endpoint-head { flex-direction: column; align-items: start; }
					.docs-actions { width: 100%; display: grid; grid-template-columns: 1fr 1fr; }
					.docs-actions .btn, .docs-actions .theme-toggle { width: 100%; }
					.docs-endpoint-body { grid-template-columns: 1fr; }
					.docs-fact { grid-template-columns: 1fr; gap: 3px; }
				}
			</style>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

templ ThemeToggle() {
	<button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode" onclick="window.emaildashToggleTheme && window.emaildashToggleTheme()">
		<span class="theme-toggle-track" aria-hidden="true"><span class="theme-toggle-knob"></span></span>
		<span data-theme-label>Dark</span>
	</button>
}

templ SetupPage(data SetupPageData) {
	@Document("Setup") {
		<div class="auth-shell">
			<div class="auth-panel">
				<div class="auth-brand">
					<div class="brand-mark">ED</div>
					<h1>Emaildash</h1>
					<p>Private mail capture, grouped inbox, and API access from one self-hosted app.</p>
				</div>
				<div class="auth-form">
					<div class="auth-form-head">
						<h2>Initialize workspace</h2>
						@ThemeToggle()
					</div>
					if data.Error != "" {
						<div class="alert alert-danger">{ data.Error }</div>
					}
					<form method="post" action={ templ.URL("/setup") } class="d-grid gap-3">
						<div>
							<label class="form-label">Password</label>
							<input class="form-control" type="password" name="password" autocomplete="new-password" required/>
						</div>
						<button class="btn btn-primary" type="submit">Initialize app</button>
					</form>
				</div>
			</div>
		</div>
	}
}

templ LoginPage(data LoginPageData) {
	@Document("Login") {
		<div class="auth-shell">
			<div class="auth-panel">
				<div class="auth-brand">
					<div class="brand-mark">ED</div>
					<h1>Emaildash</h1>
					<p>Review routed mail, inspect payloads, and manage Cloudflare delivery.</p>
				</div>
				<div class="auth-form">
					<div class="auth-form-head">
						<h2>Sign in</h2>
						@ThemeToggle()
					</div>
					if data.Error != "" {
						<div class="alert alert-danger">{ data.Error }</div>
					}
					<form method="post" action={ templ.URL("/login") } class="d-grid gap-3">
						<div>
							<label class="form-label">Password</label>
							<input class="form-control" type="password" name="password" autocomplete="current-password" required/>
						</div>
						<button class="btn btn-primary" type="submit">Log in</button>
					</form>
				</div>
			</div>
		</div>
	}
}

templ APIDocsPage(data APIDocsData) {
	@Document("API Docs") {
		<div class="docs-shell">
			<div class="docs-header">
				<div>
					<p class="eyebrow">Agent reference</p>
					<h1 class="page-title">EmailDash API</h1>
				</div>
				<div class="docs-actions">
					@ThemeToggle()
					<a class="btn btn-outline-secondary" href={ templ.URL("/api/docs/openapi.json") }>OpenAPI JSON</a>
					<a class="btn btn-outline-secondary" href={ templ.URL("/api/docs/agent.md") }>Agent MD</a>
					<a class="btn btn-outline-secondary" href={ templ.URL("/") }>Open app</a>
				</div>
			</div>
			<div class="docs-hero">
				<div class="docs-card">
					<div class="docs-card-header">
						<h2 class="docs-card-title">AI Agent Contract</h2>
					</div>
					<div class="docs-card-body">
						<pre class="docs-code">{ data.AgentPrompt }</pre>
					</div>
				</div>
				<div class="docs-card">
					<div class="docs-card-header">
						<h2 class="docs-card-title">Connection Facts</h2>
					</div>
					<div class="docs-card-body">
						<dl class="docs-facts">
							<div class="docs-fact">
								<dt>Base URL</dt>
								<dd><code>{ data.BaseURL }</code></dd>
							</div>
							<div class="docs-fact">
								<dt>Auth</dt>
								<dd><code>{ data.SampleAuth }</code></dd>
							</div>
							<div class="docs-fact">
								<dt>OpenAPI</dt>
								<dd><a href={ templ.URL("/api/docs/openapi.json") }><code>{ data.OpenAPIURL }</code></a></dd>
							</div>
							<div class="docs-fact">
								<dt>Agent guide</dt>
								<dd><a href={ templ.URL("/api/docs/agent.md") }><code>{ data.AgentMarkdownURL }</code></a></dd>
							</div>
						</dl>
					</div>
				</div>
			</div>
			<div class="docs-card mb-3">
				<div class="docs-card-header">
					<h2 class="docs-card-title">Rules Agents Should Follow</h2>
				</div>
				<div class="docs-card-body">
					<ul class="docs-list">
						for _, rule := range data.AgentRules {
							<li>{ rule }</li>
						}
					</ul>
				</div>
			</div>
			<div class="docs-card mb-3">
				<div class="docs-card-header">
					<h2 class="docs-card-title">Recommended Workflow</h2>
				</div>
				<div class="docs-card-body">
					<div class="docs-flow">
						for index, step := range data.Workflow {
							<div class="docs-step">
								<span class="docs-step-number">{ StepNumber(index) }</span>
								<h3>{ step.Title }</h3>
								<p>{ step.Body }</p>
							</div>
						}
					</div>
				</div>
			</div>
			<div class="docs-card mb-3">
				<div class="docs-card-header">
					<h2 class="docs-card-title">Python SDK Guide</h2>
					<p class="text-secondary mb-0 mt-1">Use this when the agent can install Python packages and should issue temporary addresses through the SDK.</p>
				</div>
				<div class="docs-card-body">
					<pre class="docs-code">{ data.PythonSDKGuide }</pre>
				</div>
			</div>
			<div class="docs-header mt-4">
				<div>
					<p class="eyebrow">Reference</p>
					<h2 class="h4 mb-0">Endpoints</h2>
				</div>
			</div>
			for _, endpoint := range data.Endpoints {
				<div class="docs-endpoint">
					<div class="docs-endpoint-head">
						<div>
							<h2 class="h6 mb-2"><span class="method-badge me-2">{ endpoint.Method }</span><code>{ endpoint.Path }</code></h2>
							<p class="text-secondary mb-0">{ endpoint.Description }</p>
						</div>
						<span class="status-pill neutral">{ endpoint.Auth }</span>
					</div>
					<div class="docs-endpoint-body">
						<div>
							<div class="small text-secondary fw-bold mb-1">Request</div>
							<pre class="docs-code">{ endpoint.Request }</pre>
						</div>
						<div>
							<div class="small text-secondary fw-bold mb-1">Response</div>
							<pre class="docs-code">{ endpoint.Response }</pre>
						</div>
						<div class="docs-agent-use">
							<strong>Agent use:</strong> { endpoint.AgentUse }
						</div>
					</div>
				</div>
			}
			<div class="docs-header mt-4">
				<div>
					<p class="eyebrow">Schemas</p>
					<h2 class="h4 mb-0">Response Objects</h2>
				</div>
			</div>
			for _, schema := range data.Schemas {
				<div class="docs-card docs-schema">
					<div class="docs-card-header">
						<h3 class="docs-card-title"><code>{ schema.Name }</code></h3>
						<p class="text-secondary mb-0 mt-1">{ schema.Description }</p>
					</div>
					<div class="docs-table-wrap">
						<table class="docs-table">
							<thead>
								<tr>
									<th>Field</th>
									<th>Type</th>
									<th>Meaning</th>
								</tr>
							</thead>
							<tbody>
								for _, field := range schema.Fields {
									<tr>
										<td><code>{ field.Name }</code></td>
										<td><code>{ field.Type }</code></td>
										<td>{ field.Description }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}
		</div>
	}
}

templ DashboardPage(data DashboardData) {
	@Document("Dashboard") {
		<div class="app-shell">
			<header class="topbar">
				<a class="brand" href={ templ.URL(DashboardURL("inbox", "", 0)) }>
					<span class="brand-mark">ED</span>
					<span>Emaildash</span>
				</a>
				<nav class="top-nav" aria-label="Primary">
					<a href={ templ.URL(DashboardURL("inbox", data.ActiveRecipient, data.SelectedEmailID)) } class={ TabClass(data.ActiveTab == "inbox") }>Inbox</a>
					<a href={ templ.URL(DashboardURL("cloudflare", "", 0)) } class={ TabClass(data.ActiveTab == "cloudflare") }>Cloudflare</a>
					<a href={ templ.URL(DashboardURL("password", "", 0)) } class={ TabClass(data.ActiveTab == "password") }>Password & API</a>
					<a href={ templ.URL("/api/docs") } class={ TabClass(false) }>API Docs</a>
				</nav>
				<div class="top-actions">
					@ThemeToggle()
					<form method="post" action={ templ.URL("/logout") }>
						<button class="btn btn-outline-secondary" type="submit">Logout</button>
					</form>
				</div>
			</header>
			<main class="app-main">
				<div class="page-heading">
					<div>
						<p class="eyebrow">{ PageEyebrow(data.ActiveTab) }</p>
						<h1 class="page-title">{ PageTitle(data.ActiveTab) }</h1>
					</div>
					if data.ActiveTab == "inbox" {
						<div class="metric-strip">
							<div class="metric"><strong>{ TotalMessages(data.Recipients) }</strong> stored</div>
							<div class="metric"><strong>{ TotalUnread(data.Recipients) }</strong> unread</div>
							<div class="metric"><strong>{ len(data.Recipients) }</strong> recipients</div>
						</div>
					}
				</div>
				if data.Error != "" {
					<div class="alert alert-danger">{ data.Error }</div>
				}
				if data.Notice != "" {
					<div class="alert alert-success">{ data.Notice }</div>
				}
				if data.ActiveTab == "cloudflare" {
					@CloudflareTab(data)
				} else if data.ActiveTab == "password" {
					@PasswordTab(data)
				} else {
					@InboxTab(data)
				}
			</main>
		</div>
	}
}

templ InboxTab(data DashboardData) {
	<section class="inbox-layout">
		<aside class="pane">
			<div class="pane-header">
				<h2 class="pane-title">Recipients</h2>
				<span class="count-pill">{ len(data.Recipients) }</span>
			</div>
			<div id="recipients-pane" hx-get={ RecipientsFragmentURL(data.ActiveRecipient, data.SelectedEmailID) } hx-trigger="every 5s" hx-swap="innerHTML">
				@RecipientsPartial(data)
			</div>
		</aside>
		<section class="pane">
			<div class="pane-header">
				<h2 class="pane-title">Messages</h2>
				<span class="count-pill">{ len(data.Emails) }</span>
			</div>
			<div id="emails-pane" hx-get={ EmailsFragmentURL(data.ActiveRecipient, data.SelectedEmailID) } hx-trigger="every 5s" hx-swap="innerHTML">
				@EmailsPartial(data)
			</div>
		</section>
		<section class="pane">
			<div id="viewer-pane">
				@ViewerPartial(data)
			</div>
		</section>
	</section>
}

templ RecipientsPartial(data DashboardData) {
	<div class="stack-list">
		<a href={ templ.URL(DashboardURL("inbox", "", data.SelectedEmailID)) } class={ StackItemClass(data.ActiveRecipient == "") }>
			<div class="item-main">
				<div class="item-title">All recipients</div>
				<span class="count-pill">{ TotalUnread(data.Recipients) }</span>
			</div>
			<div class="item-meta">{ TotalMessages(data.Recipients) } stored messages</div>
		</a>
		for _, recipient := range data.Recipients {
			<a href={ templ.URL(DashboardURL("inbox", recipient.Address, 0)) } class={ StackItemClass(data.ActiveRecipient == recipient.Address) }>
				<div class="item-main">
					<div class="item-title">{ recipient.Address }</div>
					<span class="count-pill">{ recipient.UnreadCount }</span>
				</div>
				if recipient.LatestSubject != nil {
					<div class="item-meta">{ *recipient.LatestSubject }</div>
				}
			</a>
		}
	</div>
}

templ EmailsPartial(data DashboardData) {
	if len(data.Emails) == 0 {
		<div class="empty-state">No emails yet.</div>
	} else {
		<div class="stack-list">
			for _, email := range data.Emails {
				<a href={ templ.URL(DashboardURL("inbox", data.ActiveRecipient, email.ID)) } class={ StackItemClass(data.SelectedEmailID == email.ID) }>
					<div class="item-main">
						<div class="item-title">{ SubjectLine(email.Subject) }</div>
						if email.ReadAt == nil {
							<span class="unread-dot" aria-label="Unread"></span>
						}
					</div>
					<div class="item-meta">{ email.MailFrom }</div>
					<div class="item-meta">{ PreviewText(email.TextBody, email.HTMLBody) }</div>
					<div class="item-meta">{ FormatTimeValue(email.ReceivedAt) }</div>
				</a>
			}
		</div>
	}
}

templ ViewerPartial(data DashboardData) {
	if data.ActiveEmail == nil {
		<div class="viewer">
			<div class="pane-header">
				<h2 class="pane-title">Message</h2>
			</div>
			<div class="empty-state">Select an email.</div>
		</div>
	} else {
		<article class="viewer">
			<header class="viewer-head">
				<h2 class="viewer-title">{ SubjectLine(data.ActiveEmail.Subject) }</h2>
				<div class="meta-grid">
					<div><strong>From</strong> { data.ActiveEmail.MailFrom }</div>
					<div><strong>To</strong> { RecipientsText(data.ActiveEmail.Recipients) }</div>
					<div><strong>Received</strong> { FormatTimeValue(data.ActiveEmail.ReceivedAt) }</div>
				</div>
			</header>
			<div class="viewer-body">
				if data.ActiveEmail.HTMLBody != "" {
					<div class="message-body email-html">
						@SanitizedHTML(data.ActiveEmail.HTMLBody)
					</div>
				} else {
					<div class="message-body">
						<pre class="pre-wrap">{ data.ActiveEmail.TextBody }</pre>
					</div>
				}
				if len(data.ActiveEmail.Attachments) > 0 {
					<ul class="attachment-list">
						for _, attachment := range data.ActiveEmail.Attachments {
							<li class="attachment-item">
								<div class="fw-bold">{ attachment.Filename }</div>
								<div class="text-secondary small">{ attachment.ContentType } / { FormatBytes(attachment.Size) }</div>
							</li>
						}
					</ul>
				}
			</div>
		</article>
	}
}

templ CloudflareTab(data DashboardData) {
	<div class="settings-grid">
		<section class="panel">
			<div class="panel-header">
				<h2 class="panel-title">Cloudflare credentials</h2>
			</div>
			<div class="panel-body">
				<form method="post" action={ templ.URL("/dashboard/cloudflare/credentials") } class="d-grid gap-3">
					<div>
						<label class="form-label">Cloudflare account email</label>
						<input class="form-control" name="email" type="email" autocomplete="email" required/>
					</div>
					<div>
						<label class="form-label">Global API key</label>
						<input class="form-control" name="apiKey" type="password" autocomplete="off" required/>
					</div>
					<button class="btn btn-primary" type="submit">Save and load domains</button>
				</form>
			</div>
		</section>
		<section class="panel">
			<div class="panel-header">
				<h2 class="panel-title">Receiving summary</h2>
			</div>
			<div class="panel-body">
				<dl class="status-list">
					<div class="status-row"><dt>Ready domains</dt><dd>{ ReadyDomainCount(data.ReceivingDomains) } / { len(data.ReceivingDomains) }</dd></div>
					<div class="status-row"><dt>Worker</dt><dd>{ ReceivingWorkerName(data.ReceivingDomains) }</dd></div>
					<div class="status-row"><dt>Source</dt><dd>Cloudflare live status</dd></div>
				</dl>
			</div>
		</section>
	</div>
	<section class="panel mt-3">
		<div class="panel-header">
			<h2 class="panel-title">Receiving domains</h2>
		</div>
		<div class="panel-body p-0">
			if len(data.ReceivingDomains) == 0 {
				<div class="empty-state">No cached zones. Save credentials first.</div>
			} else {
				<div class="table-responsive">
					<table class="table align-middle">
						<thead><tr><th>Domain</th><th>Readiness</th><th>Details</th><th class="text-end">Actions</th></tr></thead>
						<tbody>
							for _, domain := range data.ReceivingDomains {
								<tr>
									<td class="fw-bold">{ domain.Domain }</td>
									<td><span class={ StatusPillClass(domain.Ready) }>{ DomainReadyLabel(domain.Ready) }</span></td>
									<td>
										<div class="small fw-bold">{ DomainReason(domain) }</div>
										<div class="small text-secondary">{ DomainDetails(domain) }</div>
									</td>
									<td class="text-end">
										<div class="d-inline-flex gap-2 justify-content-end">
											<form method="post" action={ templ.URL("/dashboard/cloudflare/enable-receiving") }>
												<input type="hidden" name="zoneId" value={ domain.ZoneID }/>
												<button class="btn btn-outline-secondary btn-sm" type="submit">Enable receiving</button>
											</form>
											<form method="post" action={ templ.URL("/dashboard/cloudflare/disable-receiving") }>
												<input type="hidden" name="zoneId" value={ domain.ZoneID }/>
												<button class="btn btn-outline-secondary btn-sm" type="submit">Disable receiving</button>
											</form>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	</section>
}

templ PasswordTab(data DashboardData) {
	<div class="settings-grid">
		<section class="panel">
			<div class="panel-header">
				<h2 class="panel-title">Change password</h2>
			</div>
			<div class="panel-body">
				<form method="post" action={ templ.URL("/dashboard/password") } class="d-grid gap-3">
					<div>
						<label class="form-label">Current password</label>
						<input class="form-control" name="oldPassword" type="password" autocomplete="current-password" required/>
					</div>
					<div>
						<label class="form-label">New password</label>
						<input class="form-control" name="newPassword" type="password" autocomplete="new-password" required/>
					</div>
					<button class="btn btn-primary" type="submit">Update password</button>
				</form>
			</div>
		</section>
		<section class="panel">
			<div class="panel-header">
				<h2 class="panel-title">REST API key</h2>
			</div>
			<div class="panel-body">
				if data.APIKey != "" {
					<div class="api-key-box">{ data.APIKey }</div>
					<div class="mt-3 small text-secondary">Preferred: <code>Authorization: Bearer { data.APIKey }</code></div>
					<div class="mt-2 small text-secondary">Fallback: <code>?api_key={ data.APIKey }</code></div>
					<div class="mt-3"><a class="btn btn-outline-secondary btn-sm" href={ templ.URL("/api/docs") }>Open API docs</a></div>
				} else {
					<div class="empty-state p-0 text-start">API key not available yet.</div>
				}
			</div>
		</section>
	</div>
}
